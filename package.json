{
  "name": "@vita-site/theme-default",
  "version": "1.0.0-alpha.4",
  "description": "default theme for VitaSite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm test && rimraf dist && tsc -p tsconfig.build.json && cp -r src/assets ./dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "npx change-push"
  },
  "license": "MIT",
  "peerDependencies": {
    "vita-site": "^1.0.0"
  },
  "dependencies": {
    "@vita-site/plugin-container": "^1.0.0-alpha.0",
    "@vita-site/plugin-search": "^1.0.0-alpha.3",
    "@zmaui/color": "^1.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.1",
    "markdown-it": "^14.1.1",
    "sass-embedded": "1.70.0",
    "vita-site": "^1.0.2",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "vitarx": "4.0.0",
    "@vitarx/plugin-vite": "1.0.0",
    "vitarx-router": "4.0.3"
  }
}
